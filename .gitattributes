
# 默认文本文件由 Git 统一处理换行符
* text=auto

# C/C++ 与构建配置文件统一使用 LF
*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.sh text eol=lf
*.clang-format text eol=lf
.gitignore text eol=lf

# Windows 批处理文件使用 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
